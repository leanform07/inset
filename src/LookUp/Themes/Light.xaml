<!-- Colours for the light theme. Dark.xaml defines the same keys; ThemeService swaps them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1A5FB4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#5F86BF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="QuoteBorderBrush" Color="#E8E8E8" />
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
</ResourceDictionary>
