<!-- Colours for the dark theme. Same keys as Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#272727" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8E8E8E" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7DB3F5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#8FA9CF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#333333" />
    <SolidColorBrush x:Key="QuoteBorderBrush" Color="#3A3A3A" />
    <Color x:Key="SurfaceColor">#202020</Color>
</ResourceDictionary>
