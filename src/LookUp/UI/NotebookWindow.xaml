<Window x:Class="LookUp.UI.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LookUp.UI"
        Title="Inset Notebook" Width="1120" Height="700" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource GroundBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <!-- Category rows: the chosen category is marked with an ink dot and set in full ink. -->
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="10,9,22,9">
                            <DockPanel>
                                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource InkBrush}" Visibility="Hidden" />
                                <ContentPresenter x:Name="Content" TextElement.Foreground="{DynamicResource InkSecondaryBrush}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Word rows: hairline rules; the selection is a deeper ground with an ink rule (the seal colour stays for the seal). -->
        <Style x:Key="WordRow" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="0,0,0,1" Padding="0,9" SnapsToDevicePixels="True">
                            <GridViewRowPresenter TextElement.Foreground="{DynamicResource InkBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PressFillBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border BorderBrush="{DynamicResource InkBrush}" BorderThickness="0,0,0,1" Padding="6,0,6,8" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Label}" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <!-- Categories -->
        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,26,0,18">
                <TextBlock DockPanel.Dock="Top" Text="Notebook" Style="{StaticResource Title}" Margin="22,0,22,18" />
                <Button DockPanel.Dock="Bottom" Content="HOW TO USE" Style="{StaticResource QuietButton}" Margin="22,16,22,0"
                        HorizontalAlignment="Left" Click="OnHowToUseClick" ToolTip="Open the guide (in Traditional Chinese) in your browser" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Margin="22,12,22,0"
                        HorizontalAlignment="Left" Click="OnNewCategoryClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="New category" />
                    </StackPanel>
                </Button>
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CategoryItem}"
                         SelectionChanged="OnCategorySelectionChanged"
                         ContextMenuOpening="OnCategoryContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rename…" Click="OnRenameCategoryClick" />
                            <MenuItem Header="Delete" Click="OnDeleteCategoryClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:00}}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Words -->
        <DockPanel Grid.Column="1" Margin="26,24,26,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                        Click="OnExportClick" ToolTip="Exports the words currently listed, for Excel or Anki">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
                <Border BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="10,0" Height="32" SnapsToDevicePixels="True">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12"
                                   Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,8,0" />
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Filter words, Chinese or notes" Style="{StaticResource Placeholder}" Margin="1,0,0,0"
                                       Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVisible}}" />
                            <TextBox x:Name="FilterBox" Style="{StaticResource BareTextBox}" FontSize="13" TextChanged="OnFilterChanged" />
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Label}" />
                <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                    <RadioButton x:Name="FilterAll" Content="All" GroupName="StatusFilter" Style="{StaticResource Segment}" IsChecked="True" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterNew" Content="New" GroupName="StatusFilter" Style="{StaticResource Segment}" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterLearning" Content="Learning" GroupName="StatusFilter" Style="{StaticResource Segment}" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterKnown" Content="Known" GroupName="StatusFilter" Style="{StaticResource Segment}" Checked="OnFilterChanged" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <ListView x:Name="WordList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="Extended" SelectionChanged="OnWordSelectionChanged" ItemContainerStyle="{StaticResource WordRow}"
                          KeyDown="OnWordListKeyDown" MouseDoubleClick="OnWordDoubleClick" SizeChanged="OnWordListSizeChanged">
                    <ListView.ContextMenu>
                        <ContextMenu x:Name="WordMenu" Opened="OnWordMenuOpened">
                            <MenuItem x:Name="MoveToMenu" Header="Move to category" />
                            <MenuItem Header="Set status">
                                <MenuItem Header="New" Tag="New" Click="OnSetStatusClick" />
                                <MenuItem Header="Learning" Tag="Learning" Click="OnSetStatusClick" />
                                <MenuItem Header="Known" Tag="Known" Click="OnSetStatusClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Remove from notebook" Click="OnRemoveClick" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn x:Name="WordColumn" Header="WORD" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Word}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Word}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="CHINESE" Width="116">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Chinese}" FontFamily="{StaticResource CjkFont}" FontSize="13.5"
                                                   Foreground="{DynamicResource InkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="STATUS" Width="74">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="LOOKUPS" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LookupCount, StringFormat={}{0:00}}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="320" />
            </Grid>
        </DockPanel>

        <!-- The selected word's plate -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock x:Name="NoSelectionText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Text="Select a word to see its plate." />

                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid>
                        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
                        <ui:SealStamp x:Name="DetailSeal" Width="88" Height="88" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,10,14,0" RenderTransformOrigin="0.5,0.5">
                            <ui:SealStamp.RenderTransform>
                                <RotateTransform Angle="-8" />
                            </ui:SealStamp.RenderTransform>
                        </ui:SealStamp>

                        <StackPanel Margin="28,30,28,24">
                            <TextBlock Text="{Binding Word}" Style="{StaticResource Display}" FontSize="30" LineHeight="34" Margin="0,0,100,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock x:Name="PosText" Style="{StaticResource Label}" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding Ipa, StringFormat=/{0}/}" FontFamily="{StaticResource IpaFont}" FontSize="14"
                                           Foreground="{DynamicResource InkSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource Rule}" Margin="0,20,0,16" />
                            <TextBlock Text="{Binding Chinese}" Style="{StaticResource Chinese}" FontSize="16" LineHeight="25" />
                            <TextBlock Text="{Binding Definition}" Style="{StaticResource Body}" FontSize="14.5" LineHeight="22" Margin="0,6,0,0" />
                            <Border x:Name="ExampleBlock" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0"
                                    Padding="12,0,0,0" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Example}" Style="{StaticResource Secondary}" FontSize="13.5" LineHeight="20" />
                                    <TextBlock Text="{Binding ExampleChinese}" Style="{StaticResource Chinese}" FontSize="13" LineHeight="20"
                                               Foreground="{DynamicResource InkMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Right under the entry, so they show without scrolling at the default window size. -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnLookUpAgainClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Look up again" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Click="OnOpenInCambridgeClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Cambridge" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Style="{StaticResource Rule}" Margin="0,22,0,0" />

                            <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <ComboBox x:Name="CategoryEditor" IsEditable="True" FontSize="13"
                                          SelectionChanged="OnCategoryEditorSelectionChanged"
                                          LostKeyboardFocus="OnCategoryEditorLostFocus" KeyDown="OnCategoryEditorKeyDown" />
                                <TextBlock Text="Uncategorized" Style="{StaticResource Placeholder}"
                                           Visibility="{Binding Text, ElementName=CategoryEditor, Converter={StaticResource EmptyToVisible}}" />
                            </Grid>

                            <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                                <RadioButton x:Name="StatusNew" Content="New" GroupName="DetailStatus" Style="{StaticResource Segment}" Checked="OnStatusChecked" />
                                <RadioButton x:Name="StatusLearning" Content="Learning" GroupName="DetailStatus" Style="{StaticResource Segment}" Checked="OnStatusChecked" />
                                <RadioButton x:Name="StatusKnown" Content="Known" GroupName="DetailStatus" Style="{StaticResource Segment}" Checked="OnStatusChecked" />
                            </StackPanel>

                            <TextBlock Text="NOTE" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NoteEditor" Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" FontSize="13"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock x:Name="LookupInfo" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,16,0,0" />

                            <Button Content="REMOVE FROM NOTEBOOK" Style="{StaticResource QuietButton}" Foreground="{DynamicResource InkSecondaryBrush}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnRemoveClick" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <TextBlock x:Name="MultiSelectionText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
