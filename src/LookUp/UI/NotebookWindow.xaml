<Window x:Class="LookUp.UI.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LookUp Notebook" Width="1080" Height="660" MinWidth="780" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Categories -->
        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,14">
                <TextBlock DockPanel.Dock="Top" Text="Notebook" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="18,0,18,14" />
                <Button DockPanel.Dock="Bottom" Content="+ New category" Style="{StaticResource LinkButton}"
                        FontSize="13" Margin="18,10,18,0" HorizontalAlignment="Left" Click="OnNewCategoryClick" />
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnCategorySelectionChanged"
                         ContextMenuOpening="OnCategoryContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rename…" Click="OnRenameCategoryClick" />
                            <MenuItem Header="Delete" Click="OnDeleteCategoryClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="18,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Words -->
        <DockPanel Grid.Column="1" Margin="18,18,18,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Export CSV" Style="{StaticResource LinkButton}"
                        FontSize="13" VerticalAlignment="Center" Click="OnExportClick"
                        ToolTip="Exports the words currently listed" />
                <ComboBox x:Name="StatusFilter" DockPanel.Dock="Right" Width="112" Margin="10,0,16,0"
                          SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All statuses" />
                    <ComboBoxItem Content="New" />
                    <ComboBoxItem Content="Learning" />
                    <ComboBoxItem Content="Known" />
                </ComboBox>
                <Grid>
                    <TextBox x:Name="FilterBox" FontSize="13" Padding="4,4" TextChanged="OnFilterChanged" />
                    <TextBlock Text="Filter  (Ctrl+F)" Style="{StaticResource Placeholder}"
                               Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVisible}}" />
                </Grid>
            </DockPanel>

            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedBrush}" />

            <Grid>
                <ListView x:Name="WordList" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                          SelectionMode="Extended" SelectionChanged="OnWordSelectionChanged"
                          Foreground="{DynamicResource TextBrush}" FontSize="13"
                          KeyDown="OnWordListKeyDown" MouseDoubleClick="OnWordDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu x:Name="WordMenu" Opened="OnWordMenuOpened">
                            <MenuItem x:Name="MoveToMenu" Header="Move to category" />
                            <MenuItem Header="Set status">
                                <MenuItem Header="New" Tag="New" Click="OnSetStatusClick" />
                                <MenuItem Header="Learning" Tag="Learning" Click="OnSetStatusClick" />
                                <MenuItem Header="Known" Tag="Known" Click="OnSetStatusClick" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Remove from notebook" Click="OnRemoveClick" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Word" Width="150" DisplayMemberBinding="{Binding Word}" />
                            <GridViewColumn Header="Chinese" Width="150" DisplayMemberBinding="{Binding Chinese}" />
                            <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Lookups" Width="60" DisplayMemberBinding="{Binding LookupCount}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
            </Grid>
        </DockPanel>

        <!-- Details of the selected word -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock x:Name="NoSelectionText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                           Text="Select a word to see its details." />

                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="22,18,22,18">
                        <TextBlock Text="{Binding Word}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding PartOfSpeech}" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Ipa, StringFormat=/{0}/}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Chinese}" FontSize="15" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Definition}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border x:Name="ExampleBlock" BorderBrush="{DynamicResource QuoteBorderBrush}" BorderThickness="2,0,0,0"
                                Padding="10,0,0,0" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Example}" FontStyle="Italic" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding ExampleChinese}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource AccentSoftBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,0" />

                        <TextBlock Text="Category" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <ComboBox x:Name="CategoryEditor" IsEditable="True" FontSize="13"
                                      SelectionChanged="OnCategoryEditorSelectionChanged"
                                      LostKeyboardFocus="OnCategoryEditorLostFocus" KeyDown="OnCategoryEditorKeyDown" />
                            <TextBlock Text="Uncategorized" Style="{StaticResource Placeholder}"
                                       Visibility="{Binding Text, ElementName=CategoryEditor, Converter={StaticResource EmptyToVisible}}" />
                        </Grid>

                        <TextBlock Text="Status" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StatusNew" Content="New" GroupName="DetailStatus" Margin="0,0,16,0" Checked="OnStatusChecked" />
                            <RadioButton x:Name="StatusLearning" Content="Learning" GroupName="DetailStatus" Margin="0,0,16,0" Checked="OnStatusChecked" />
                            <RadioButton x:Name="StatusKnown" Content="Known" GroupName="DetailStatus" Checked="OnStatusChecked" />
                        </StackPanel>

                        <TextBlock Text="Note" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="NoteEditor" Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" FontSize="13" Padding="4,4"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock x:Name="LookupInfo" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,14,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Look up again" Style="{StaticResource LinkButton}" FontSize="13"
                                    Margin="0,0,18,0" Click="OnLookUpAgainClick" />
                            <Button Content="Open in Cambridge ↗" Style="{StaticResource LinkButton}" FontSize="13"
                                    Click="OnOpenInCambridgeClick" />
                        </StackPanel>
                        <Button Content="Remove from notebook" Style="{StaticResource LinkButton}" FontSize="12"
                                Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="OnRemoveClick" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="MultiSelectionText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
