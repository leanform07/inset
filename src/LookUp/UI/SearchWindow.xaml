<Window x:Class="LookUp.UI.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inset Search" Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource GroundBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" />

        <StackPanel Margin="30,34,30,22">
            <Grid>
                <TextBlock Text="Look up a word or phrase" Style="{StaticResource Placeholder}" FontSize="26" Margin="1,0,0,0"
                           Visibility="{Binding Text, ElementName=Input, Converter={StaticResource EmptyToVisible}}" />
                <!-- English-only box: the IME is off so a Chinese input mode never swallows the typing. -->
                <TextBox x:Name="Input" Style="{StaticResource BareTextBox}" FontSize="26"
                         InputMethod.IsInputMethodEnabled="False" />
            </Grid>
            <Border Height="1" Background="{DynamicResource InkBrush}" Margin="0,12,0,0" SnapsToDevicePixels="True" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
            <TextBlock x:Name="Hint" Style="{StaticResource Label}" />
        </Border>
    </Grid>
</Window>
