<Window x:Class="LookUp.UI.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GroundBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" />
        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
        <StackPanel Margin="26,30,26,20">
            <TextBox x:Name="Input" Style="{StaticResource BareTextBox}" FontSize="18" />
            <Border Height="1" Background="{DynamicResource InkBrush}" Margin="0,8,0,0" SnapsToDevicePixels="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                <Button x:Name="ActionButton" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="72" Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
