<Window x:Class="LookUp.UI.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="20,16,20,14">
        <TextBox x:Name="Input" FontSize="14" Padding="4,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource LinkButton}"
                    Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource LinkButton}" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
