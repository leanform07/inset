<Window x:Class="LookUp.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LookUp.UI"
        Title="LookUp Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D13438" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="26,22,26,18">
        <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Look up selected text" Style="{StaticResource RowLabel}" />
            <StackPanel Grid.Column="1">
                <ui:HotkeyBox x:Name="LookupBox" FontSize="13" />
                <TextBlock x:Name="LookupError" Style="{StaticResource RowError}" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Search box" Style="{StaticResource RowLabel}" Margin="0,10,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                <ui:HotkeyBox x:Name="SearchBox" FontSize="13" />
                <TextBlock x:Name="SearchError" Style="{StaticResource RowError}" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Notebook" Style="{StaticResource RowLabel}" Margin="0,10,0,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                <ui:HotkeyBox x:Name="NotebookBox" FontSize="13" />
                <TextBlock x:Name="NotebookError" Style="{StaticResource RowError}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Reset to defaults" Style="{StaticResource LinkButton}"
                    FontSize="12" Click="OnResetHotkeysClick" />
            <TextBlock Text="Click a box, then press the new shortcut." FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" />
        </DockPanel>

        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20" />

        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeSystem" Content="Same as Windows" GroupName="Theme" Margin="0,0,20,0" Checked="OnThemeChecked" />
            <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Margin="0,0,20,0" Checked="OnThemeChecked" />
            <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Checked="OnThemeChecked" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20" />

        <TextBlock Text="Startup" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="StartupBox" Content="Start LookUp when I sign in to Windows"
                  Checked="OnStartupChanged" Unchecked="OnStartupChanged" />

        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,0,14" />

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Style="{StaticResource LinkButton}"
                    FontSize="13" VerticalAlignment="Bottom" Click="OnCloseClick" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,16,0"
                       Text="LookUp is an unofficial tool. Dictionary content comes from Cambridge Dictionary © Cambridge University Press." />
        </DockPanel>
    </StackPanel>
</Window>
