<Window x:Class="LookUp.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LookUp.UI"
        Title="Inset Settings" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource GroundBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowError" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
        <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" />
        <StackPanel Margin="32,34,32,24">
            <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="Look up selected text" Style="{StaticResource RowLabel}" />
                <StackPanel Grid.Column="1">
                    <ui:HotkeyBox x:Name="LookupBox" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    <TextBlock x:Name="LookupError" Style="{StaticResource RowError}" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Search box" Style="{StaticResource RowLabel}" Margin="0,10,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <ui:HotkeyBox x:Name="SearchBox" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    <TextBlock x:Name="SearchError" Style="{StaticResource RowError}" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Notebook" Style="{StaticResource RowLabel}" Margin="0,10,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                    <ui:HotkeyBox x:Name="NotebookBox" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    <TextBlock x:Name="NotebookError" Style="{StaticResource RowError}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Reset to defaults" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="OnResetHotkeysClick" />
                <TextBlock Text="Click a box, then press the new shortcut." Style="{StaticResource Secondary}" FontSize="12.5" />
            </DockPanel>

            <Border Style="{StaticResource Rule}" Margin="0,24" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                <RadioButton x:Name="ThemeSystem" Content="Same as Windows" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemeChecked" />
                <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemeChecked" />
                <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemeChecked" />
            </StackPanel>

            <Border Style="{StaticResource Rule}" Margin="0,24" />

            <TextBlock Text="Startup" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="StartupBox" Content="Start Inset when I sign in to Windows" FontSize="14"
                      Checked="OnStartupChanged" Unchecked="OnStartupChanged" />

            <Border Style="{StaticResource Rule}" Margin="0,24,0,16" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Done" IsCancel="True" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom" Click="OnCloseClick" />
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,24,0" LineHeight="16"
                           Text="UNOFFICIAL TOOL. ENTRIES FROM CAMBRIDGE DICTIONARY © CAMBRIDGE UNIVERSITY PRESS." />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
