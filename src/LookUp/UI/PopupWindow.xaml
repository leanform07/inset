<Window x:Class="LookUp.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Inset" Width="440" Height="560" MinWidth="360" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource GroundBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Token bar: which dictionary, and how often this word has come up. It is also the
             handle for moving the window (the WebView below swallows mouse input). -->
        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,0"
                Background="Transparent" MouseLeftButtonDown="OnTokenBarMouseDown">
            <DockPanel>
                <!-- Only once the window has been resized; double-clicking the bar does the same. -->
                <Button x:Name="ResetSizeButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Margin="16,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="OnResetSizeClick"
                        ToolTip="Return the window to its default size" Content="DEFAULT SIZE" />
                <TextBlock x:Name="CountToken" DockPanel.Dock="Right" Style="{StaticResource Token}" />
                <TextBlock x:Name="SourceToken" Style="{StaticResource Label}" Text="EN · 中文" />
            </DockPanel>
        </Border>

        <!-- The WebView is a native child window, so WPF content cannot draw over it:
             it is hidden whenever the status panel is showing. It also takes the mouse, so the
             side margins leave the window's own edge free for resizing. -->
        <wv2:WebView2 x:Name="Web" Grid.Row="1" Margin="5,0" Visibility="Hidden" />

        <!-- Loading, notices, no result and errors share the entry's plate: same margins, same baseline. -->
        <Grid x:Name="StatusPanel" Grid.Row="1">
            <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
            <Path Style="{StaticResource Crosshair}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" />

            <StackPanel Margin="28,30,28,0">
                <TextBlock x:Name="StatusTitle" Style="{StaticResource Display}" />
                <TextBlock x:Name="StatusMessage" Style="{StaticResource Secondary}" FontSize="14.5" Margin="0,8,0,0" />

                <StackPanel x:Name="SuggestionsPanel" Margin="0,26,0,0" Visibility="Collapsed">
                    <TextBlock Text="DID YOU MEAN" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource Rule}" />
                    <ItemsControl x:Name="Suggestions" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnSuggestionClick" Cursor="Hand" FocusVisualStyle="{StaticResource FocusOutline}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,9">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"
                                                               Foreground="{DynamicResource InkMutedBrush}" />
                                                    <TextBlock Text="{Binding}" FontSize="15" Foreground="{DynamicResource InkBrush}" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource PressFillBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,26,0,0" Visibility="Collapsed">
                    <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,18,0" Click="OnRetryClick" />
                    <Button x:Name="WebSearchButton" Style="{StaticResource QuietButton}" Click="OnWebSearchClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SEARCH THE WEB" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Opens under the entry after "Add to notebook"; everything in it is optional. -->
        <Border x:Name="NotePanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource GroundSolidBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}" Padding="28,16,28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="CATEGORY" Style="{StaticResource Label}" />
                <Grid Grid.Column="1">
                    <ComboBox x:Name="CategoryBox" IsEditable="True" FontSize="13" />
                    <TextBlock Text="Uncategorized" Style="{StaticResource Placeholder}"
                               Visibility="{Binding Text, ElementName=CategoryBox, Converter={StaticResource EmptyToVisible}}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="STATUS" Style="{StaticResource Label}" Margin="0,10,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="1,10,0,0">
                    <RadioButton x:Name="StatusNew" Content="New" GroupName="PopupStatus" Style="{StaticResource Segment}" />
                    <RadioButton x:Name="StatusLearning" Content="Learning" GroupName="PopupStatus" Style="{StaticResource Segment}" />
                    <RadioButton x:Name="StatusKnown" Content="Known" GroupName="PopupStatus" Style="{StaticResource Segment}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="NOTE" Style="{StaticResource Label}" Margin="0,10,0,0" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                    <TextBox x:Name="NoteBox" FontSize="13" />
                    <TextBlock Text="Where you saw it, a memory trick…" Style="{StaticResource Placeholder}"
                               Visibility="{Binding Text, ElementName=NoteBox, Converter={StaticResource EmptyToVisible}}" />
                </Grid>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnNoteRemoveClick"
                            ToolTip="Remove this word from the notebook" />
                    <Button Content="Done" Style="{StaticResource PrimaryButton}" Click="OnNoteDoneClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}" Padding="16,8" MinHeight="48">
            <DockPanel>
                <Button x:Name="OpenInCambridgeButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"
                        VerticalAlignment="Center" Click="OnOpenInCambridgeClick" ToolTip="Open this entry on dictionary.cambridge.org">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CAMBRIDGE" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="NotebookButton" DockPanel.Dock="Left" HorizontalAlignment="Left" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}" Click="OnNotebookButtonClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NotebookIcon" Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock x:Name="NotebookLabel" Text="Add to notebook" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotebookShortcut" Text="CTRL+S" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Opacity="0.6" Margin="10,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
