<Window x:Class="LookUp.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LookUp" Width="420" Height="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The WebView is a native child window, so WPF content cannot draw over it:
             it is hidden whenever the status panel is showing. -->
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

        <StackPanel x:Name="StatusPanel" Margin="22,18,22,0">
            <TextBlock x:Name="StatusTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" />

            <StackPanel x:Name="SuggestionsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock Text="Did you mean" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                <ItemsControl x:Name="Suggestions" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource LinkButton}" FontSize="15"
                                    Margin="0,3" HorizontalAlignment="Left" Click="OnSuggestionClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,18,0,0" Visibility="Collapsed">
                <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource LinkButton}"
                        FontSize="14" Margin="0,0,18,0" Click="OnRetryClick" />
                <Button x:Name="WebSearchButton" Content="Search the web →" Style="{StaticResource LinkButton}"
                        FontSize="14" Click="OnWebSearchClick" />
            </StackPanel>
        </StackPanel>

        <!-- Opens under the entry after "Add to notebook"; everything in it is optional. -->
        <Border x:Name="NotePanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource SubtleSurfaceBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="22,12,22,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Column="1">
                        <ComboBox x:Name="CategoryBox" IsEditable="True" FontSize="13" />
                        <TextBlock Text="Uncategorized" Style="{StaticResource Placeholder}"
                                   Visibility="{Binding Text, ElementName=CategoryBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="StatusNew" Content="New" GroupName="PopupStatus" Margin="0,0,14,0" />
                        <RadioButton x:Name="StatusLearning" Content="Learning" GroupName="PopupStatus" Margin="0,0,14,0" />
                        <RadioButton x:Name="StatusKnown" Content="Known" GroupName="PopupStatus" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Note" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <TextBox x:Name="NoteBox" FontSize="13" Padding="2,3" />
                        <TextBlock Text="Where you saw it, a memory trick…" Style="{StaticResource Placeholder}"
                                   Visibility="{Binding Text, ElementName=NoteBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </Grid>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource LinkButton}" FontSize="13"
                            Click="OnNoteDoneClick" />
                    <Button Content="Remove from notebook" Style="{StaticResource LinkButton}" FontSize="12"
                            Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Click="OnNoteRemoveClick" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="22,9">
            <DockPanel>
                <Button x:Name="OpenInCambridgeButton" DockPanel.Dock="Right" Content="Open in Cambridge ↗"
                        Style="{StaticResource LinkButton}" FontSize="12" Click="OnOpenInCambridgeClick" />
                <Button x:Name="NotebookButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}"
                        FontSize="12" Margin="0,0,14,0" Visibility="Collapsed" Click="OnNotebookButtonClick"
                        ToolTip="Ctrl+S" />
                <TextBlock x:Name="FooterNote" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
