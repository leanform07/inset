<Window x:Class="LookUp.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LookUp" Width="420" Height="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="White" FontFamily="{StaticResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The WebView is a native child window, so WPF content cannot draw over it:
             it is hidden whenever the status panel is showing. -->
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" DefaultBackgroundColor="White" />

        <StackPanel x:Name="StatusPanel" Margin="22,18,22,0">
            <TextBlock x:Name="StatusTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />

            <StackPanel x:Name="SuggestionsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock Text="Did you mean" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                <ItemsControl x:Name="Suggestions" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource LinkButton}" FontSize="15"
                                    Margin="0,3" HorizontalAlignment="Left" Click="OnSuggestionClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,18,0,0" Visibility="Collapsed">
                <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource LinkButton}"
                        FontSize="14" Margin="0,0,18,0" Click="OnRetryClick" />
                <Button x:Name="WebSearchButton" Content="Search the web →" Style="{StaticResource LinkButton}"
                        FontSize="14" Click="OnWebSearchClick" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}" Padding="22,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open in Cambridge ↗" Style="{StaticResource LinkButton}"
                        FontSize="12" Click="OnOpenInCambridgeClick" />
                <TextBlock x:Name="FooterNote" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
