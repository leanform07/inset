<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The product is Inset; the code keeps the LookUp namespace it was written under. -->
    <AssemblyName>Inset</AssemblyName>
    <RootNamespace>LookUp</RootNamespace>
    <Product>Inset</Product>
    <AssemblyTitle>Inset</AssemblyTitle>
    <Version>0.2.0</Version>
    <!-- Only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 asks Windows Forms apps to set DPI in code; this is a WPF app, where the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LookUp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Draw text selection behind the text, not over it, so a selected word stays readable. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Forms is only used for NotifyIcon; keep its names out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Drawn by tools/make_icon.py; no letters, so it does not depend on the name. -->
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Geist is SIL OFL 1.1: the licence travels with the fonts. -->
    <None Include="Assets\Fonts\Geist-OFL.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\*.js;Web\*.css;Web\*.html" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
